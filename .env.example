# Central API
CENTRAL_API_URL=http://host.docker.internal:8000
GATEWAY_API_KEY=your-gateway-api-key-here

# WhatsApp
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_COMPANY_MAPPING_FILE=/app/config/whatsapp_company_mapping.json

# Microsoft Graph
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_NOTIFICATION_CLIENT_STATE=your-random-client-state
GRAPH_SUBSCRIPTION_RESOURCE=/users/{userId}/mailFolders('Inbox')/messages

# Retries
REQUEST_TIMEOUT=30.0
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT=1.0
RETRY_MAX_WAIT=10.0

# Idempotency
IDEMPOTENCY_BACKEND=database
IDEMPOTENCY_TTL_SECONDS=86400

# Database (for idempotency via unique constraint)
DATABASE_URL=sqlite+aiosqlite:////app/data/gateway.db

# Logs
LOG_LEVEL=INFO